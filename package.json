{
  "name": "gm-electric-store",
  "version": "1.0.0",
  "description": "Desktop POS, Inventory & Khata System for GM Electric Store",
  "main": "electron/main.js",
  "scripts": {
    "dev": "cd frontend && next dev",
    "build": "cd frontend && next build",
    "start": "cd frontend && next start",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "npm run build && electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "lucide-react": "^0.344.0",
    "next": "14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.12.2",
    "tailwind-merge": "^2.2.1",
    "clsx": "^2.1.0"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.18",
    "concurrently": "^8.2.2",
    "electron": "^29.1.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.gmelectric.store",
    "productName": "GM Electric Store Manager",
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "database/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    }
  }
}
