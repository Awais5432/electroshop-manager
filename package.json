{
  "name": "electroshop-manager",
  "version": "1.0.0",
  "description": "Desktop POS, Inventory & Khata System for Electric Shops",
  "main": "electron/main.js",
  "scripts": {
    "dev": "next dev frontend",
    "build": "next build frontend && electron-builder",
    "start": "next start frontend",
    "electron": "electron .",
    "electron:dev": "concurrently \"npm run dev\" \"wait-on http://localhost:3000 && electron .\"",
    "export": "next build frontend && next export frontend -o dist",
    "package": "npm run export && electron-builder"
  },
  "keywords": [
    "pos",
    "inventory",
    "khata",
    "electronic-shop",
    "desktop-app"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "express": "^4.18.2",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "node-thermal-printer": "^4.4.2",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "concurrently": "^8.2.2",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.electroshop.manager",
    "productName": "ElectroShop Manager",
    "directories": {
      "output": "release",
      "app": "."
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
